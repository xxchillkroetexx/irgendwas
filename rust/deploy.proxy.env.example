# Docker Compose behind an existing reverse proxy; see ../docs/deployment.md.
# Copy to prod.env, fill in values and keep it private (chmod 600 prod.env).
APP_URL=https://wichteln.example
APP_LOCALE=de
APP_TIMEZONE=Europe/Berlin
INACTIVITY_LIMIT=1200
HTTP_PORT=8080

# Trust only the proxy peer as seen by the app. For rootful Docker with a proxy
# on the host this is normally the dedicated bridge gateway. Check before use.
# Empty means no forwarded client addresses are trusted (shared rate limit).
TRUSTED_PROXIES_CIDR=172.31.251.1/32
# Change both if the subnet conflicts with existing networks; update trust above.
PROXY_SUBNET=172.31.251.0/24
PROXY_GATEWAY=172.31.251.1

DB_DATABASE=irgendwas_db
DB_USERNAME=irgendjemand
# Required: replace with two different, long, random passwords.
DB_PASSWORD=
DB_ROOT_PASSWORD=

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Secret Santa"

# Built locally by default. Pin APP_IMAGE to a version/digest for registry use.
# APP_IMAGE=git.scheissndreck.de/irgendwas/irgendwas:sha-<12-character-commit>
CARGO_BUILD_JOBS=2
RUST_LOG=info
