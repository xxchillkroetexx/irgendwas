# Production settings for compose.yml. Copy to prod.env (any name except .env, which is the
# development config) and run:
#   podman compose --env-file prod.env -f compose.yml up -d --build
# Same names as the PHP app's .env.template.

# Application
APP_URL=https://wichteln.example
APP_DEBUG=false
APP_LOCALE=en
APP_TIMEZONE=Europe/Berlin
INACTIVITY_LIMIT=7776000

# Caddy
# Edge setup (Caddy terminates TLS): CADDY_SITE_ADDRESS=wichteln.example, CADDY_AUTO_HTTPS=on
# Behind Traefik/nginx (TLS terminated outside): CADDY_SITE_ADDRESS=:80, CADDY_AUTO_HTTPS=off
CADDY_SITE_ADDRESS=wichteln.example
CADDY_AUTO_HTTPS=on
# Proxies IN FRONT OF Caddy, space-separated CIDRs. Empty when Caddy is the edge.
# compose.yml adds Caddy's own address for the app only (see README "Production").
TRUSTED_PROXIES_CIDR=
# Host ports Caddy publishes (behind a proxy on the same host: HTTP_BIND=127.0.0.1, HTTP_PORT=8080)
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Only change if 172.31.250.0/24 collides with another network on the host.
#EDGE_SUBNET=172.31.250.0/24
#CADDY_IP=172.31.250.10

# Database
DB_DATABASE=irgendwas_db
DB_USERNAME=irgendjemand
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Mail (465 = implicit TLS "ssl", 587 = STARTTLS "tls")
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Secret Santa"

# App image (built by `--build`, or pull one from a registry)
#APP_IMAGE=localhost/irgendwas-rust:latest
RUST_LOG=info
