# Production settings for compose.yml. Copy to prod.env (any name except .env, which is the
# development config) and run:
#   podman compose --env-file prod.env -f compose.yml up -d --build
# Then start Traefik from deploy/traefik/ (README "Production").
# Same variable names as the old PHP app's .env.

# Application
APP_URL=https://wichteln.example
APP_DEBUG=false
APP_LOCALE=en
APP_TIMEZONE=Europe/Berlin
INACTIVITY_LIMIT=1200
# Registrations + password resets per client IP and hour (empty = 20). Raise it only if many
# users share one address, e.g. under rootless podman (see README "Trusted proxies").
RATE_LIMIT_MAIL_PER_IP=

# Caddy. Recommended setup: Traefik on the host (deploy/traefik/) terminates TLS and
# connects to Caddy's loopback port; Caddy serves plain HTTP.
CADDY_SITE_ADDRESS=:80
CADDY_AUTO_HTTPS=off
# Host address/port Caddy publishes. Keep 127.0.0.1: the trust below is only safe because
# nothing but host-local processes (Traefik) can reach this port. The port must match the
# service URL in deploy/traefik/dynamic/irgendwas.yml.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Proxies IN FRONT OF Caddy as Caddy sees them, space-separated CIDRs (compose.yml adds
# Caddy's own address for the app). Rootless podman: connections to the published port
# arrive from Caddy's own address, so trust 172.31.250.10/32 (= CADDY_IP). Rootful
# podman/Docker: check `remote_ip` in Caddy's log (often the gateway 172.31.250.1/32).
TRUSTED_PROXIES_CIDR=172.31.250.10/32
# Alternative, Caddy is the TLS edge (adds deploy/caddy-edge/compose.yml):
#   CADDY_SITE_ADDRESS=wichteln.example  CADDY_AUTO_HTTPS=on  HTTP_BIND=0.0.0.0
#   HTTP_PORT=80  HTTPS_PORT=443  TRUSTED_PROXIES_CIDR=   (empty: nobody in front)
# Only change if 172.31.250.0/24 collides with another network on the host.
#EDGE_SUBNET=172.31.250.0/24
#CADDY_IP=172.31.250.10

# Database
DB_DATABASE=irgendwas_db
DB_USERNAME=irgendjemand
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Mail (465 = implicit TLS "ssl", 587 = STARTTLS "tls")
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Secret Santa"

# App image (built by `--build`, or pull one from a registry)
# Prebuilt image from CI: :latest (main), :dev (dev) or :sha-<12 chars> (any of their commits).
# Leave unset to build locally (localhost/irgendwas-rust:latest via --build).
#APP_IMAGE=git.scheissndreck.de/irgendwas/irgendwas:latest
RUST_LOG=info
