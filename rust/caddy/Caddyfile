# Caddy in front of the Rust app (rust/compose.yml). Everything is configured through
# environment variables set by compose:
#
#   CADDY_SITE_ADDRESS   site address. `:80` (default) = plain HTTP, e.g. behind Traefik/nginx;
#                        a domain such as `wichteln.example` = Caddy is the TLS edge.
#   CADDY_AUTO_HTTPS     on | off (default) | disable_redirects. `on` lets Caddy obtain
#                        certificates for a domain site address and redirect HTTP to HTTPS.
#   TRUSTED_PROXIES_CIDR space-separated CIDRs of the proxies in front of Caddy, whose
#                        X-Forwarded-For Caddy trusts. Empty (trust nobody) when Caddy is the
#                        edge. From an untrusted peer Caddy replaces X-Forwarded-For with the
#                        peer address, so clients cannot forge it.
#
# The app trusts the same list plus Caddy's own address (see compose.yml). HTTPS detection in
# the app uses APP_URL only, never request headers.

# One snippet per CADDY_AUTO_HTTPS value. `on` is Caddy's default, so it adds nothing.
(auto_https_on) {
}
(auto_https_off) {
	auto_https off
}
(auto_https_disable_redirects) {
	auto_https disable_redirects
}

{
	admin off
	import auto_https_{$CADDY_AUTO_HTTPS:off}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES_CIDR}
		# Read X-Forwarded-For from the right, like the app: the client is the first
		# untrusted hop. Without it Caddy logs the leftmost (client-supplied) entry as
		# `client_ip`, i.e. whatever a client forged.
		trusted_proxies_strict
	}
}

{$CADDY_SITE_ADDRESS::80} {
	# Access log (JSON) on stdout; `remote_ip` / `client_ip` show what Caddy sees as the
	# peer and the client, which helps when setting TRUSTED_PROXIES_CIDR.
	log {
		output stdout
		format json
	}

	encode zstd gzip

	reverse_proxy app:3000

	header {
		# Enable HTTP Strict Transport Security (HSTS)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Disable content-type sniffing
		X-Content-Type-Options "nosniff"
		# Legacy XSS filter
		X-XSS-Protection "1; mode=block"
		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"
		# Control the information sent in the Referer header
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove the Server header
		-Server
	}
}
