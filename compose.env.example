# Production settings for compose.yml: the Portainer stack's environment, or a file such as
# prod.env (any name except .env, which is the development config) used with
#   docker compose --env-file prod.env up -d

# Image (CI: :latest = main, :dev = dev, :sha-<12 chars> = any of their commits)
#APP_IMAGE=git.scheissndreck.de/irgendwas/irgendwas
APP_TAG=latest

# Application
APP_URL=https://wichteln.example
APP_DEBUG=false
APP_LOCALE=de
APP_TIMEZONE=Europe/Berlin
INACTIVITY_LIMIT=1200
# Registrations + password resets per client IP and hour (empty = 20).
RATE_LIMIT_MAIL_PER_IP=
RUST_LOG=info

# Traefik (an existing container on the Docker network proxynet)
# Host name of APP_URL, for the router rule.
APP_HOST=wichteln.example
# Traefik's own address on proxynet (give it a fixed IP). Only this /32, never the whole
# network: any container on proxynet could forge client addresses otherwise. Find it with
#   docker network inspect proxynet --format '{{range .Containers}}{{.Name}} {{.IPv4Address}}{{"\n"}}{{end}}'
TRUSTED_PROXIES_CIDR=172.18.0.3/32
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Database
DB_DATABASE=irgendwas_db
DB_USERNAME=irgendjemand
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Mail (465 = implicit TLS "ssl", 587 = STARTTLS "tls")
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Secret Santa"
