# Copy to .env for local development. Strict dotenv format: no inline comments.
# Real environment variables always take precedence over this file.

# Application
APP_URL=http://localhost:3000
APP_DEBUG=true
APP_LOCALE=en
APP_TIMEZONE=Europe/Berlin
# Rolling session inactivity timeout in seconds (90 days; renewed on each request)
INACTIVITY_LIMIT=7776000

# Registration/password-reset calls per client IP and hour. Production keeps the default (20,
# leave unset); dev and the e2e server run the whole Playwright suite from one IP.
RATE_LIMIT_MAIL_PER_IP=1000

# Database (matches compose.dev.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=irgendwas_db
DB_USERNAME=irgendjemand
DB_PASSWORD=devpassword

# Used by #[sqlx::test] and sqlx-cli. Needs a user that may CREATE DATABASE (root in dev).
# Used only by #[sqlx::test] and sqlx-cli: the RAM-backed `mariadb-test` service (port 3308).
# The app itself connects via DB_HOST/DB_PORT (persistent dev DB on 3307).
DATABASE_URL=mysql://root:devrootpassword@127.0.0.1:3308/irgendwas_db

# Mail (465 = implicit TLS "ssl", 587 = STARTTLS "tls", "none" = plain, e.g. Mailpit)
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Secret Santa"

# Logging
RUST_LOG=info,server=debug,app=debug
